# Kokoro TTS API Configuration

# API Settings
PORT=8880
HOST=0.0.0.0
API_LOG_LEVEL=INFO

# Application Settings
DEFAULT_VOICE=af_heart
USE_GPU=true
# DEVICE_TYPE=cpu  # Optional: force cpu, cuda, or mps

# Paths (Inside container defaults)
# MODEL_DIR=/app/api/src/models
# VOICES_DIR=/app/api/src/voices/v1_0

# Model Download (Set to true to auto-download on first start)
DOWNLOAD_MODEL=false

# Audio Settings
SAMPLE_RATE=24000
DEFAULT_VOLUME_MULTIPLIER=1.0

# Web Player
ENABLE_WEB_PLAYER=true
CORS_ENABLED=true
